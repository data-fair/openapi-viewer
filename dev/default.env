# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 6200-6249 so that they rarely collide with other local services.
DEV_HOST=localhost
NGINX_PORT=6200
DEV_API_PORT=6201
DEV_UI_PORT=6202
DEV_UI_HMR_PORT=6203
MONGO_PORT=6204
SD_PORT=6205
